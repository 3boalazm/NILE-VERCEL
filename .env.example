# Copy to `.env` and fill in real values before starting the server.
# `.env*` is gitignored — never commit the real file.
#
# These two are required by the *running app*, not by the build: `next build`
# substitutes build-only placeholders when they are missing (it never needs
# production secrets, and it never needs a database — the catalog is read at
# request time). On Vercel, set them as project environment variables instead
# of a file: Project Settings → Environment Variables. See docs/OPS.md § 10.

# --- Required ---
# Signs Payload JWTs / encrypts fields. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Postgres connection string. Payload auto-creates collection tables on first boot.
DATABASE_URI=postgresql://user:password@localhost:5432/npf

# --- Vendure (commerce backend) ---
# Vendure connects with discrete fields (Payload above uses DATABASE_URI for
# the same physical database). All six are validated at boot by the zod schema
# in src/lib/env.ts — a missing one now fails with every problem listed at
# once, instead of reaching the pg driver as NaN/undefined.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=npf
DB_USERNAME=postgres
DB_PASSWORD=
# Postgres schema Vendure's tables live in (default: public).
DB_SCHEMA=public
# Signs the Vendure session cookie. Minimum 32 characters, enforced — a short
# secret is a real forgeable-session risk. Generate: openssl rand -base64 32
COOKIE_SECRET=change-me-to-a-long-random-string

# Postgres connection pool ceiling PER PROCESS (pg's own default is 10). With
# a Next server and a Vendure worker on one host, the effective connection
# count is roughly double this number — Postgres' default max_connections is
# 100, so 10-20 per process is a sane starting point. Validated 1..200.
# Shared by Payload's adapter and Vendure's TypeORM `extra.max` (F-71).
DATABASE_POOL_MAX=10

# Environment name. `dev` enables Vendure's API debug modes and the GraphiQL
# IDE at /graphiql/shop and /graphiql/admin (see docs/GRAPHQL.md); anything
# else — including an unset value — is treated as production and disables
# both. Validated against dev|staging|production.
APP_ENV=dev
# Port the Vendure server binds. PORT wins when also set (hosting platforms
# inject it at runtime); VENDURE_SERVER_PORT is the fallback.
VENDURE_SERVER_PORT=3001

# Bootstrap super-admin, created by Vendure on first boot if it does not exist
# (read as `authOptions.superadminCredentials` in src/vendure-config.ts). Note
# the exact names: SUPERADMIN_USERNAME / SUPERADMIN_PASSWORD — a
# `SUPERADMIN_USER`/`SUPERADMIN_PASS` pair is silently ignored and the
# super-admin is then created with no usable credentials.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=
# Shop API endpoint for cart / checkout / account / live pricing.
# Optional at build time. Missing live commerce means NO published prices /
# order buttons; demo prices require MOCK_CATALOG_FALLBACK explicitly.
VENDURE_SHOP_API_URL=http://localhost:3001/shop-api

# --- Optional ---
# GA4 measurement id (format G-XXXXXXXXXX). Empty/unset = no analytics load at
# all: the consent-gated loader (src/components/npf/analytics-provider.tsx)
# stays inert and the site ships zero third-party measurement. When set,
# events queue on window.dataLayer from the first page view but are
# TRANSMITTED only after the visitor grants cookie consent (F-18 banner);
# refusal keeps gtag off entirely. Event contract: docs/ANALYTICS.md.
NEXT_PUBLIC_GA_ID=

# Serve the sample blog article (verification fixture for the F-13 article
# template + generated TOC). Unset = the listing shows its honest "coming
# soon" state and no article routes exist. Sample pages are watermarked and
# noindexed; never enable in production.
MOCK_BLOG_FALLBACK=0

# Serve the in-memory mock catalog when Payload/Postgres is unreachable.
# Default is UNSET = fail closed: a database outage returns an error on
# catalog routes instead of showing mock products/prices to real customers.
# Only enable for offline development / browsing the UI without a database
# (NOT for production): set it to 1 below.
MOCK_CATALOG_FALLBACK=

# Storefront origin used by the client bundle (and as the fallback for
# STOREFRONT_URL above when that is unset). Inlined at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Session lifetime (F-56) ---
# Days a storefront session stays valid. Clamped at 30 in code, so a larger
# value cannot silently reinstate the previous one-year session; unset means
# 30. Active users roll forward (the cookie is rewritten on every auth call),
# so this only expires genuinely idle sessions.
NPF_SESSION_MAX_AGE_DAYS=30

# --- Content-Security-Policy rollout (F-11) ---
# The policy itself lives in next.config.ts, scoped storefront vs admin, and is
# verified in a real browser by scripts/probe-manual-checks.mjs.
#   enforce      (default) send Content-Security-Policy
#   report-only  send Content-Security-Policy-Report-Only — trial a change
#                without risking a broken page (needs NPF_CSP_REPORT_URI to
#                actually see the violations)
#   off          send no CSP header at all
NPF_CSP_MODE=enforce
# Optional collector for violation reports, appended as `report-uri`.
NPF_CSP_REPORT_URI=

# --- Error reporting (F-65) ---
# Unset everywhere, errors are written as structured JSON records only (server
# log / browser console). Setting a DSN posts Sentry envelopes directly to
# Sentry's ingest API — no SDK dependency; see src/lib/telemetry/report-error.ts.
# The NEXT_PUBLIC_ variant is the one the browser uses (it is inlined at build
# time, so changing it requires a rebuild); it must be a PUBLIC key, never a
# secret one. Rate-limited to 20 events/minute per process to stop a render
# loop from flooding the collector.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Alternative to Sentry: any HTTPS endpoint that accepts a POSTed JSON record.
NPF_ERROR_ENDPOINT=
NEXT_PUBLIC_ERROR_ENDPOINT=

# --- Outbound email (F-52) ---
# Nothing sends real mail until SMTP_HOST is set. Unset, both mail systems
# degrade to their dev behaviour instead of failing: Vendure's EmailPlugin
# writes .eml files to static/email/test-emails (and serves the /mailbox dev
# route), and Payload's adapter logs the message and resolves. An inquiry
# submission or a password-reset request therefore still succeeds locally.
# SMTP_SECURE=true means implicit TLS on connect (port 465); leave it false for
# STARTTLS on 587. SMTP_USER/SMTP_PASS are only used when BOTH are present.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Defaults to "Nile Pharma Food" <noreply@{SMTP_HOST minus any smtp. prefix}>.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Absolute origin used to build the links INSIDE outbound email (password
# reset, email verification). Vendure's templates append `?token=…` themselves,
# so set the bare origin only, with no trailing slash and no path. Falls back
# to NEXT_PUBLIC_SERVER_URL, then http://localhost:3000. Previously these links
# were hard-coded to a dead http://localhost:8080 scaffold origin, so a reset
# email — even if delivered — linked nowhere.
STOREFRONT_URL=http://localhost:3000

# Absolute public origin of the Vendure server — used to build the Kashier
# webhook URL sent to the gateway (their server calls it back after payment).
# Must be reachable from the internet in production; leave unset in local
# dev (the gateway handler falls back to http://localhost:3001).
VENDURE_PUBLIC_URL=

# Require customers to click an emailed verification link before their new
# account can sign in (Vendure `authOptions.requireVerification`). Keep this
# OFF unless SMTP above is really configured: with no mail delivery a required
# verification email never arrives and every new customer is locked out of the
# account they just created. The consuming route (/ar/verify) now exists.
NPF_REQUIRE_EMAIL_VERIFICATION=false

# --- Local database containers (docker-compose.yml) ---
# The compose file has no fixed, committed passwords — every database
# password is read from these variables (with a safe default for the
# usernames/database names). Only needed if you `docker compose up` the
# local dev databases; use unique values (e.g. `openssl rand -base64 24`).
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=

# --- Design preview only (NEVER for customer-facing production) ---
# Both flags opt into a direct mock catalog; mutations are blocked, and a
# visible banner identifies demo products/prices. Keep unset in production.
NPF_PREVIEW_MODE=0
MOCK_CATALOG_FALLBACK=0

# --- Proxy trust / abuse protection ---
# Configure ONLY a header the edge overwrites (x-real-ip or cf-connecting-ip),
# OR set the exact trusted X-Forwarded-For hop count from the RIGHT.
# Without either, requests share a conservative "unknown" identity.
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
# Multi-instance production still needs a shared/edge rate limiter.

# --- Vendure SMTP (separate backend environment; do not expose NEXT_PUBLIC_*) ---
# Disabled unless explicit. Enabling without complete settings fails startup.
# Uses the SMTP_HOST/PORT/USER/PASS and STOREFRONT_URL values above, plus a sender.
# STOREFRONT_URL must be a public HTTPS origin outside local development.
VENDURE_EMAIL_ENABLED=false
EMAIL_DEV_MAILBOX=false
SMTP_FROM=
VENDURE_ASSET_URL_PREFIX=

# Storefront-side switch: enable ONLY after real delivery/reset/replay tests
# against the deployed Vendure SMTP sender. No SMTP secrets needed here.
PASSWORD_RESET_ENABLED=false
