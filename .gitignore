# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the documented template — safe to commit, contains no secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload — local upload storage, not source
/media

# Vendure CLI — machine-local installation id (written on first `vendure` run),
# not source. Came in via the testing bundle; must never be committed.
/.vendure

# Local `scripts/verify-fixes.mjs` run logs (before/after evidence), not source
/.verify-runs

# Database archives written by scripts/backup-db.sh (F-53) — never commit
/.backups/

# EmailPlugin devMode file-transport output (generated by smoke tests)
static/email/
# Local diagnostic tooling / build outputs
/.cache/
/dist/
/static/email/test-emails/

# Historical visual-review captures stay in the Arena workspace; keep the
# compact final discovery evidence and all source imagery in the PR.
/docs/review-2026-10-15/**/*.png
/docs/review-2026-10-15/**/*.webp
/docs/upgrade-2026-10-15/**/*.png
/docs/upgrade-2026-10-15/**/*.webp
!/docs/upgrade-2026-10-15/discovery-evidence/*.webp
